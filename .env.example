# ── LLM ────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1   # Override with Ollama URL for local LLM
OPENAI_MODEL=gpt-4o-mini

# ── Qdrant ──────────────────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=                              # Leave empty for unauthenticated local deploy
QDRANT_COLLECTION_NAME=omnisearch

# ── Notion ──────────────────────────────────────────────────────────────────────
NOTION_TOKEN=secret_...
NOTION_ROOT_PAGE_ID=                         # Root database or page ID to crawl from

# ── Confluence ──────────────────────────────────────────────────────────────────
CONFLUENCE_URL=https://yourcompany.atlassian.net
CONFLUENCE_USER_EMAIL=admin@yourcompany.com
CONFLUENCE_TOKEN=...
CONFLUENCE_SPACE_KEY=DOCS

# ── HuggingFace ─────────────────────────────────────────────────────────────────
HF_HOME=/app/.cache/huggingface              # Mounted cache volume in Docker
HF_TOKEN=                                    # Optional, for private models

# ── Backend ─────────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:8501,http://frontend:8501

# ── Frontend ─────────────────────────────────────────────────────────────────────
CHAINLIT_AUTH_SECRET=                        # Set for auth-gated deployments
BACKEND_URL=http://backend:8000              # Internal Docker network address

# ── Settings override ────────────────────────────────────────────────────────────
SETTINGS_PATH=config/settings.yaml
